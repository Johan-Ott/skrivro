{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Skrivro may do everywhere: read and write texts, dialogs, notices, restart, talk to Google Drive, and send feedback the writer chooses to send.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "process:allow-restart",
    "opener:allow-reveal-item-in-dir",
    "opener:default",
    "notification:default",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://www.googleapis.com/*"
        },
        {
          "url": "https://oauth2.googleapis.com/*"
        },
        {
          "url": "https://api.github.com/repos/Johan-Ott/skrivro/releases"
        },
        {
          "url": "https://api.github.com/repos/Johan-Ott/skrivro/releases/latest"
        },
        {
          "url": "https://api.github.com/repos/Johan-Ott/skrivro/releases/tags/*"
        }
      ]
    }
  ]
}
