{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skrivro",
  "version": "0.4.14",
  "identifier": "se.skrivro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Skrivro",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 500,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "En lokal skrivapp för romanförfattare",
    "longDescription": "Skrivro är en skrivapp för romanförfattare. Texten sparas som vanliga filer i en mapp du väljer, utan konton och utan servrar.",
    "copyright": "© 2026 Lone Lodge",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Swedish", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "template": "windows/installer.nsi",
        "compression": "lzma"
      }
    },
    "publisher": "Lone Lodge"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMDlCMTQyODg2NEE2ODkKUldTSnBtU0lRckVKbXBTMFU5dXR5eTNtamVhbmdVZFNaTTZ1TVJZNXlzTVFrQVZiL2ZvcndSTkgK",
      "endpoints": ["https://github.com/Johan-Ott/skrivro/releases/latest/download/latest.json"]
    }
  }
}
